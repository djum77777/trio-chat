{
  "name": "@animocabrands/minds-client-lib",
  "version": "0.1.7",
  "description": "TypeScript client for Minds by Animoca Brands Builder API",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate-types": "openapi-typescript ../../spec/openapi.build.json -o src/types.gen.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "2.1.9",
    "openapi-typescript": "^7.6.1",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  }
}
