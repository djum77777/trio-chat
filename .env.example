# Copy to .env and fill in. MOCK=1 needs no key.
PORT=4100
MOCK=0
# Provider: minds (hellominds.ai) | openai (any OpenAI-compatible API)
PROVIDER=minds

# --- Minds (hellominds.ai Builder API, header X-Api-Key) ---
MINDS_BUILDER_API_KEY=
# Mind name or mindId (UUID) per agent; defaults to the agent name. See GET /api/minds
MINDY_MIND=Mindy
CHEFFY_MIND=Cheffy
FUNNY_MIND=Funny
# MINDS_ALIAS_PREFIX=trio-chat-
# MINDS_TIMEOUT_MS=120000

# --- OpenAI-compatible (PROVIDER=openai) ---
# xAI Grok: https://api.x.ai/v1   OpenAI: https://api.openai.com/v1
DEFAULT_BASE_URL=https://api.x.ai/v1
DEFAULT_MODEL=grok-3-mini
DEFAULT_API_KEY=
# Optional per-agent overrides: MINDY_/CHEFFY_/FUNNY_ + PROVIDER / BASE_URL / MODEL / API_KEY

# --- Optional server-side TTS (default: browser voices). Set ONE key. ---
# ElevenLabs (natural, multilingual incl. Indonesian)
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# OpenAI TTS (gpt-4o-mini-tts supports style instructions; tts-1 also works)
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Per-agent voice (ElevenLabs voice_id, or OpenAI voice name: alloy, ash, coral, nova, sage, shimmer...)
# MINDY_TTS_VOICE=sage
# CHEFFY_TTS_VOICE=ash
# FUNNY_TTS_VOICE=coral
